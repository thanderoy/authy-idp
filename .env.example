# Copy to .env for local development. For production, set these in the
# compose environment instead (see DEPLOYMENT.md). With DEBUG=False the server
# refuses to start without DJANGO_SECRET_KEY, REDIS_URL, a signing key and
# DEFAULT_FROM_EMAIL.

# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY='generate-one: python -c "import secrets; print(secrets.token_urlsafe(50))"'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# --- Reverse proxy -----------------------------------------------------------
# Number of proxies in front of the app (Traefik alone = 1). Trusts
# X-Forwarded-Proto/Host/For from them. Keep 0 when nothing is in front.
TRUSTED_PROXY_COUNT=0

# --- Data stores -------------------------------------------------------------
# Defaults to SQLite under src/ when unset.
# DATABASE_URL=postgresql://user:password@localhost:5432/authy_oidc_db
# Required when DEBUG=False; the in-memory fallback is per process.
# REDIS_URL=redis://localhost:6379/0

# --- OIDC signing key --------------------------------------------------------
# Either the PEM itself in OIDC_RSA_PRIVATE_KEY, or a path (default: oidc.key
# at the repo root). Generate: openssl genrsa -out oidc.key 4096
# OIDC_RSA_PRIVATE_KEY_PATH=/path/to/oidc.key
# Retired keys, comma-separated, still published in JWKS during a rotation.
OIDC_RSA_PRIVATE_KEYS_INACTIVE_PATHS=

# --- Admin and metrics -------------------------------------------------------
# The admin is served at ADMIN_URL, reachable only from ADMIN_IP_WHITELIST
# (addresses or CIDR ranges, "*" for any; empty denies everyone when
# DEBUG=False), and needs an OTP token unless ADMIN_REQUIRE_OTP=False.
ADMIN_URL=pick-something-unguessable/
ADMIN_IP_WHITELIST=10.8.0.0/24
ADMIN_REQUIRE_OTP=True
# Prometheus scrapes /metrics; same rules as ADMIN_IP_WHITELIST.
METRICS_IP_WHITELIST=10.8.0.0/24

# --- Brute-force protection --------------------------------------------------
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
PASSWORD_RESET_EMAILS_PER_HOUR=3

# --- Email (verification links, password resets) ----------------------------
# Defaults to the console backend with DEBUG=True and SMTP otherwise.
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- CORS and logging --------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://app1.example.com,https://app2.example.com
# Created if missing; defaults to src/logs/.
LOG_DIR=

# --- Error tracking ----------------------------------------------------------
SENTRY_DSN=
